# Ganj environment — EXAMPLE ONLY. Never put real values in this file.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.

# ─── Content backend selection (Phase 4a) ─────────────────────────────────────
# "supabase" (default) keeps production behaviour unchanged.
# "d1" routes the server-side content reads (poets, poet, category poems, poem,
# chapter, neighbours, migrated-poet-ids) to the ganj-d1-worker.
# Search, Telegram, faal-core, bookmarks and auth are NOT switched by this flag yet.
CONTENT_BACKEND=supabase

# Base URL of the deployed ganj-d1-worker (server-only; never NEXT_PUBLIC_*).
D1_WORKER_URL=https://ganj-d1-worker.<your-subdomain>.workers.dev
# Shared secret sent as the `X-Ganj-Key` header; mirror it as the Worker secret `GANJ_KEY`.
# Server-only: do NOT prefix with NEXT_PUBLIC_.
D1_WORKER_SECRET=replace-with-the-worker-secret
# Search backend (Phase 4d). "supabase" (default, unset) keeps the legacy /api/search.
# "d1" serves /api/search from the Worker. Independent of CONTENT_BACKEND: CONTENT_BACKEND=d1
# alone does NOT switch search.
SEARCH_BACKEND=supabase
# Search fallback (Phase 4c). Default on. Set to "false" to return 503 instead of falling back
# to the Supabase search when the Worker fails. Only read when SEARCH_BACKEND=d1.
SEARCH_FALLBACK_SUPABASE=true

# ─── Supabase (still required for auth + user/operational tables) ─────────────
# Public values (safe for the browser):
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Server-only:
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_CONTACT_TABLE=contact_messages

# ─── Optional integrations ────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
